PORT=3001
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/task_keeper?retryWrites=true&w=majority
MONGODB_DATABASE=task_keeper
DB_POOL_MAX=10
JWT_SECRET=replace-this-with-a-long-random-secret
NODE_ENV=development

# Optional email delivery. Reminders remain visible in the app if email is not configured.
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=

# Optional browser push delivery. Generate keys with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
