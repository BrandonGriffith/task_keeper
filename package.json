{
  "name": "task_keeper",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --watch --watch-preserve-output server/src/index.js\" \"vite client --host 0.0.0.0 --config client/vite.config.js\"",
    "build": "npm run build --workspace client",
    "test": "npm run test --workspace server",
    "start": "npm run start --workspace server"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
